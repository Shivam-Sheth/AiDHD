# All integrations run in mock/standby until keys are set.
# Prava is the hard submission requirement — prioritize this key.

# LLM — Gemini is preferred when set; OpenAI used when Gemini absent / as fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PRAVA_SECRET_KEY=
PRAVA_API_KEY=
# Required for the real @prava-sdk/core collectPAN() flow on /agent — without
# it, checkout falls back to the pay_url/mock path. pk_test_*/pk_live_* is
# safe to read server-side and hand to the browser (not a secret).
PRAVA_PUBLISHABLE_KEY=

SENSO_API_KEY=

# Linq iMessage / RCS / SMS (Partner API v3) — https://linqapp.com/hackathon
LINQ_API_KEY=
# E.164 Linq number from sandbox dashboard
LINQ_PHONE_NUMBER=
# Optional webhook signing secret
LINQ_WEBHOOK_SECRET=

# Supabase (traveler vault — server service role only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ char secret for AES-GCM passport encryption (never commit real value)
AIDHD_VAULT_KEY=

# Supabase Auth (Sign in with Google on /login, via @supabase/supabase-js).
# Project Settings → API. Same project as NEXT_PUBLIC_SUPABASE_URL above —
# reuse that URL value here unless this is intentionally a different project.
# Read client-side, so both are inlined into the JS bundle via next.config.ts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Then: Supabase Dashboard → Authentication → Providers → Google → paste your
# Google OAuth Client ID + Secret, and in Google Cloud Console register this
# as the Authorized redirect URI (NOT our own /api route):
#   https://<project-ref>.supabase.co/auth/v1/callback
# Run in the Supabase SQL editor (same project):
#   supabase/profiles.sql
#   supabase/traveler_profiles.sql
#   supabase/groups.sql          ← parties, encrypted chat, invites, booking drafts
#   supabase/upgrade_v2.sql      ← reactions, reads, polls, approvals, calendar,
#                                  SMS links, notifications, chat-uploads bucket

# Google Calendar OAuth (Account → Connect Google Calendar).
# Google Cloud Console → OAuth client (web) with redirect URI:
#   https://<host>/api/calendar/oauth/callback
# Without these, calendar connect runs in demo/mock mode.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional Google Maps Routes (airport→hotel ETA)
GOOGLE_MAPS_API_KEY=

META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Must match the Verify Token you paste in Meta webhook config
META_WHATSAPP_VERIFY_TOKEN=aidhd_verify
META_GRAPH_VERSION=v25.0
# First-touch opener (Meta sandbox ships hello_world)
META_WHATSAPP_TEMPLATE=hello_world
META_WHATSAPP_TEMPLATE_LANG=en_US
# Optional: map Jordan demo user to a real test phone (+1...)
WHATSAPP_JORDAN_PHONE=
WHATSAPP_DEFAULT_EVENT_ID=evt_demo_friday

# Cross-instance WhatsApp state (JSONBlob id)
AIDHD_STATE_BLOB_ID=

# Llama 3 inference (Meta Llama API / Groq / Together)
LLAMA_API_KEY=

DUFFEL_API_KEY=
# Same Duffel token covers flights + stays/hotels (Amadeus self-service is decommissioned)

# Shopify — the merchant Prava's one-time card actually checks out against.
# your-store.myshopify.com (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=
# Public Storefront API token: Shopify admin -> Settings -> Apps and sales
# channels -> Headless channel -> Create storefront. Used for product search
# (search_products tool) + cart creation. Safe to read server-side; this repo
# never inlines it into the client bundle.
# NOTE: this must be a Storefront token, NOT an Admin API token — Admin
# tokens are prefixed shpat_/shpca_/shpss_/shpua_ and will 401 here. A real
# Storefront token has no such prefix (plain hex/opaque string).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2025-10. Bump periodically per shopify.dev/docs/api/release-notes.
SHOPIFY_API_VERSION=2025-10

# Preferred browser transport for checkout/browser-harness.ts (Shopify
# checkout automation) — a hosted remote browser Playwright connects to over
# CDP. No Chromium binary in our Vercel function bundle, no cold-start
# download, no maxDuration pressure from launching a browser locally. Falls
# back to @sparticuz/chromium (in-function) if unset.
BROWSERBASE_API_KEY=
# Optional — inferred from the API key if omitted.
BROWSERBASE_PROJECT_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Live Concierge agent (browser voice + tool lookups) — preferred over outbound calls
ELEVENLABS_AGENT_ID=
# Optional: sync tools with POST /api/agent/sync after deploy
# AIDHD_AGENT_TOOL_SECRET=
# Dedicated outbound booking caller (MUST be separate from ELEVENLABS_AGENT_ID —
# get_payment_card lives only here). Sync overrides after create/deploy:
#   curl -X POST /api/booking/call/sync
ELEVENLABS_BOOKING_AGENT_ID=
# Legacy outbound / templates (optional)
ELEVENLABS_HOTEL_AGENT_ID=
ELEVENLABS_RESEARCH_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
VOICE_CONFIRM_PHONE=

# Optional legacy dialer (ElevenAgents outbound preferred)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Maps JavaScript API + Geocoding API must both be enabled for this key.
# Read server-side (page.tsx) and passed to the client map — Maps JS keys are
# not secret, restrict by HTTP referrer in Google Cloud Console instead.
# Same key also drives get_weather: enable Geocoding API + Weather API on it too
# (server-side calls, so IP-restrict it in Cloud Console rather than by referrer).
# Hotel-anchored map (reviews + routes) needs two more enabled on this key:
#   - Places API (New)  — client-side Place.fetchFields() review lookups
#   - Routes API        — server-side computeRoutes (walk/bike/drive/transit + polyline)
GOOGLE_MAPS_API=

